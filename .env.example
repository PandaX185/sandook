# Copy to .env and adjust. Everything has dev-safe defaults, so this file is optional for local dev.

# --- Postgres ---
POSTGRES_PASSWORD=sandook-dev-password

# --- Backend ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# HS256 needs >= 32 chars. CHANGE THIS for anything beyond local dev.
JWT_SECRET=change-me-dev-secret-0123456789abcdef0123456789abcdef

# --- Frontend (base URL the browser uses to reach the API) ---
NEXT_PUBLIC_API_URL=http://localhost:8081
